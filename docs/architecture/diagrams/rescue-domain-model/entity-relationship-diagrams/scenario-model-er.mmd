---
title: Scenario experiments + ShipMarket (ER logical groups; isolated run data)
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
erDiagram
    direction TB
    %% Logical ER view; dashed lines do not imply UML dependency or lifecycle ownership.
    %% Simulation runs own isolated mission copies and do not use the operational run-scoped central registry.
    %% Each run owns an isolated Mission copy, which owns request transitions and mission invariants; these are behaviours, not additional ER fields.
    %% Run-local B3Market counts active unaccepted RFQOffer holds, pending requests, and confirmed requests once each per ship against the latest copied ShipAvailability.total_seats.
    %% Acceptance atomically transfers a quote hold into a pending request; quote rejection/expiry releases only unaccepted holds; ship refusal releases pending commitment.
    %% Logical group Experiments: scenarios, runs and results.
    RescueScenario {
        string scenario_id PK
        integer revision
        string name
        data baseline
        data response_rules
        data availability_changes
        number time_horizon_seconds
        integer seed
    }
    CommunicationProfile {
        string profile_id PK
        number outbound_delay_seconds
        number decision_delay_seconds
        number return_delay_seconds
        data loss_rule
        data duplication_rule
        data reordering_rule
    }
    SimulationRun {
        string run_id PK
        datetime started_at
        datetime finished_at
        string status
    }
    SimulationResult {
        boolean completed
        integer confirmed_seats
        integer unmet_demand
        integer requests_sent
        integer released_seats
        number confirmation_elapsed_seconds "optional"
        number latest_arrival_estimate_seconds "optional"
    }
    %% Logical group Communication: messages and delivery attempts.
    CommunicationMessage {
        string message_id PK
        string correlation_id
        string kind
        data payload
        datetime sent_at
    }
    MessageDelivery {
        string delivery_id PK
        integer attempt_number
        datetime received_at "optional"
        string disposition
        string reason
    }
    %% Logical group CoreReferences: Mission and SeatRequest workflow data.
    Mission {
        string mission_id PK
        string station_name
        integer people_count
        datetime created_at
    }
    %% MissionData is registration input: a value object, not stored, so it has no primary key.
    MissionData {
        string mission_id
        string station_name
        integer people_count
        datetime created_at
    }
    %% Shared Mission semantics: people_count is fixed after registration.
    %% Logical group ShipMarket begins: Ship, availability, ship offers, RFQs and quote offers.
    B3Market {
        string market_id PK
    }
    Ship {
        string ship_id PK
        string name
    }
    ShipAvailability {
        string availability_id PK
        string ship_id
        integer total_seats
        number arrival_estimate_seconds
        boolean available
        datetime recorded_at
    }
    ShipOffer {
        string offer_id PK
        string mission_id
        string ship_id
    }
    ShipOfferRevision {
        string revision_id PK
        integer revision_number
        integer capacity
        number arrival_estimate_seconds
        boolean available
        datetime recorded_at
    }
    SeatRFQ {
        string rfq_id PK
        string mission_id
        string ship_id
        string availability_id
        integer requested_seats
        string status
        datetime sent_at
        datetime response_deadline "optional"
    }
    RFQOffer {
        string offer_id PK
        string rfq_id
        integer offered_seats
        number arrival_estimate_seconds
        datetime expires_at
        datetime recorded_at
        string status
    }
    SeatRequest {
        string request_id PK
        string command_id
        string mission_id
        string ship_id
        integer requested_seats
        integer confirmed_seats
        RequestOutcome outcome
        datetime submitted_at
        datetime response_received_at "optional"
        datetime response_deadline "optional"
        datetime closed_at "optional"
        string quote_id "optional"
        string revision_id "optional"
        string decision_id "optional"
    }
    %% RequestTiming is an elapsed-time projection: a value object, not stored, so it has no primary key.
    RequestTiming {
        datetime submitted_at
        datetime response_received_at "optional"
        decimal waiting_seconds
        decimal response_elapsed_seconds "optional"
    }
    RequestHistoryEntry {
        string event_id PK
        integer mission_sequence
        datetime recorded_at
        HistoryAction action
        integer confirmed_seats_delta
        integer pending_seats_delta
        string reason
        string message_id "optional"
    }
    MobilisationPolicy {
        string policy_id PK
        integer revision
        string name
        data selection_criteria
    }
    RescueScenario ||..o{ CommunicationProfile : "configures"
    CommunicationProfile }o..|| Ship : "targets baseline ship"
    SimulationRun }o..|| RescueScenario : "uses revision"
    SimulationRun }o..|| MobilisationPolicy : "compares revision"
    SimulationRun ||..|| Mission : "owns isolated copy"
    SimulationRun ||..|| B3Market : "owns isolated market copy"
    SimulationRun ||..o| SimulationResult : "produces at finish"
    B3Market ||..o{ ShipAvailability : "tracks copied ship capacity"
    Ship ||..o{ ShipAvailability : "reports snapshot"
    Mission ||..o{ ShipOffer : "has copied offer history"
    Ship ||..o{ ShipOffer : "supplies"
    ShipOffer ||..|{ ShipOfferRevision : "versions; highest revision is current"
    Mission ||..o{ SeatRFQ : "requests quotations"
    B3Market ||..o{ SeatRFQ : "sends one per available ship in run"
    ShipAvailability ||..o{ SeatRFQ : "copied snapshot referenced by"
    Ship ||..o{ SeatRFQ : "addressed ship"
    SeatRFQ ||..o| RFQOffer : "receives at most one response"
    Mission ||..o{ SeatRequest : "owns"
    Mission ||..o{ RequestHistoryEntry : "records changes"
    MissionData ||..|| Mission : "registers"
    SeatRequest ||..|| RequestTiming : "derives"
    SeatRequest }o..o| ShipOfferRevision : "optionally preserves basis"
    RFQOffer o|..o| SeatRequest : "optional accepted quote starts pending ship confirmation"
    SeatRequest ||..o{ CommunicationMessage : "correlates"
    CommunicationMessage ||..|{ MessageDelivery : "tracks attempts"
    RequestHistoryEntry }o..o| CommunicationMessage : "triggered by"
