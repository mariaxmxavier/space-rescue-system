---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Full conceptual attributes; namespace boxes are visual groups only.
    namespace Experiments {
        class RescueScenario {
            -string scenario_id
            -integer revision
            -string name
            -RunBaseline baseline
            -ScriptedResponse response_rules
            -ShipAvailability availability_changes
            -number time_horizon_seconds
            -integer seed
            -integer event_budget
        }
        class RunBaseline {
            -Mission missions
            -B3Market market
            -data command_index
            -data message_index
            -data delivery_index
            -data decision_index
            -data session_index
        }
        class ScriptedResponse {
            -string ship_id
            -integer request_ordinal
            -string outcome
            -integer confirmed_seats
        }
        class CommunicationProfile {
            -string profile_id
            -string ship_id
            -number outbound_delay_seconds
            -number decision_delay_seconds
            -number return_delay_seconds
            -data loss_rule
            -data duplication_rule
            -data reordering_rule
        }
        class SimulationRun {
            -string run_id
            -string scenario_id
            -integer scenario_revision
            -string policy_id
            -integer policy_revision
            -datetime started_at
            -datetime finished_at
            -string status
        }
        class RunSnapshot {
            -SimulationRun run
            -Mission missions
            -B3Market market
            -data command_index
            -data message_index
            -data delivery_index
            -data decision_index
            -data session_index
        }
        class SimulationResult {
            -boolean completed
            -integer confirmed_seats
            -integer unmet_demand
            -integer requests_sent
            -integer released_seats
            -number confirmation_elapsed_seconds
            -number latest_arrival_estimate_seconds
        }
    }
    namespace Communication {
        class CommunicationMessage {
            -string message_id
            -string correlation_id
            -string kind
            -data payload
            -datetime sent_at
            -string request_id
        }
        class MessageDelivery {
            -string delivery_id
            -integer attempt_number
            -datetime received_at
            -DeliveryDisposition disposition
            -DeliveryReason reason
            -number communication_rtt_seconds
            -SessionEnvelope envelope
        }
        class SessionEnvelope {
            -string session_id
            -integer version
            -FlowDirection direction
            -integer sequence
        }
        class CommunicationSession {
            -string session_id
            -integer version
            -integer next_inbound
            -integer next_outbound
            -DecisionReport reports
            -NotApplied gaps
            -RecoveryRequest outstanding_recovery
        }
        class NotApplied {
            -string session_id
            -integer version
            -integer from_sequence
            -integer count
        }
        class DecisionReport {
            -string report_id
            -SessionEnvelope envelope
            -string message_id
            -string delivery_id
            -string mission_id
            -DeliveryDisposition disposition
            -DeliveryReason reason
            -integer mission_sequence
            -integer after_mission_sequence
        }
        class RecoveryRequest {
            -string session_id
            -integer version
            -integer from_sequence
            -integer count
        }
        class SequenceControl {
            -string session_id
            -integer version
            -FlowDirection direction
            -integer next_sequence
        }
        class ReportCursor {
            -string session_id
            -integer version
            -integer next_expected
            -DecisionReport buffered
        }
        class DeliveryDisposition {
            <<enumeration>>
            applied
            ignored
            lost
            rejected
            late
        }
        class DeliveryReason {
            <<enumeration>>
            response_applied
            identity_conflict
            transport_loss
            unknown_request
            invalid_input
            closed_request
            deadline_expired
            unknown_mission
            unknown_ship
            insufficient_demand
            insufficient_capacity
            unavailable
            expired_quote
            revision_conflict
            duplicate_sequence
        }
        class FlowDirection {
            <<enumeration>>
            inbound
            outbound
        }
        class RecoveryRejection {
            <<enumeration>>
            stale_session
            recovery_out_of_range
            recovery_limit
            recovery_in_progress
            sequence_rewind
        }
    }
    namespace ScenarioBaseline {
        class RunBaseline {
            -data command_index
            -data message_index
            -data delivery_index
            -data decision_index
            -data session_index
        }
    }
    namespace CoreReferences {
        class Mission {
            -string mission_id
            -string station_name
            -integer people_count
            -datetime created_at
        }
        class MissionData {
            -string mission_id
            -string station_name
            -integer people_count
            -datetime created_at
        }
        %% Shared Mission semantics: people_count is fixed after registration.
        class SeatRequest {
            -string request_id
            -string command_id
            -string mission_id
            -string ship_id
            -integer requested_seats
            -integer confirmed_seats
            -RequestOutcome outcome
            -datetime submitted_at
            -datetime response_received_at
            -datetime response_deadline
            -datetime closed_at
            -string quote_id
            -string revision_id
            -string decision_id
        }
        class RequestTiming {
            -datetime submitted_at
            -datetime response_received_at
            -decimal waiting_seconds
            -decimal response_elapsed_seconds
        }
        class RequestHistoryEntry {
            -string event_id
            -integer mission_sequence
            -datetime recorded_at
            -HistoryAction action
            -integer confirmed_seats_delta
            -integer pending_seats_delta
            -string reason
            -string message_id
        }
        class RequestOutcome {
            <<enumeration>>
            pending
            accepted
            partially_accepted
            refused
            cancelled
            expired
        }
        class HistoryAction {
            <<enumeration>>
            request_created
            accepted
            partially_accepted
            refused
            cancelled
            expired
        }
        class MobilisationPolicy {
            -string policy_id
            -integer revision
            -string name
            -data selection_criteria
        }
    }
    namespace ShipMarket {
        class B3Market {
            -string market_id
        }
        class Ship {
            -string ship_id
            -string name
        }
        class ShipAvailability {
            -string availability_id
            -integer total_seats
            -number arrival_estimate_seconds
            -boolean available
            -datetime recorded_at
        }
        class ShipOffer {
            -string offer_id
            -string mission_id
            -string ship_id
        }
        class ShipOfferRevision {
            -string revision_id
            -integer revision_number
            -integer capacity
            -number arrival_estimate_seconds
            -boolean available
            -datetime recorded_at
        }
        class SeatRFQ {
            -string rfq_id
            -string mission_id
            -string ship_id
            -string availability_id
            -integer requested_seats
            -string status
            -datetime sent_at
            -datetime response_deadline
        }
        class RFQOffer {
            -string offer_id
            -integer offered_seats
            -number arrival_estimate_seconds
            -datetime expires_at
            -datetime recorded_at
            -string status
        }
    }
    RescueScenario "1" *-- "0..*" CommunicationProfile : configures
    RescueScenario "1" *-- "1" RunBaseline : starts from
    RescueScenario "1" *-- "0..*" ScriptedResponse : scripts
    RunBaseline "1" --> "1..*" Mission : holds baseline missions
    RunBaseline "1" --> "1" B3Market : holds baseline market
    RunSnapshot "1" --> "1" SimulationRun : wraps
    CommunicationProfile "0..*" --> "1" Ship : targets baseline ship
    SimulationRun "0..*" --> "1" RescueScenario : uses revision
    SimulationRun "0..*" --> "1" MobilisationPolicy : compares revision
    SimulationRun "1" *-- "1" Mission : owns isolated copy
    SimulationRun "1" *-- "1" B3Market : owns isolated market copy
    note for B3Market "Run-local copy counts active unaccepted RFQOffer holds, pending requests, and confirmed commitments once each per ship against the latest copied ShipAvailability.total_seats. Hold transfer is atomic; operational market is unchanged."
    note for Mission "Owns request transitions and mission invariants"
    SimulationRun "1" *-- "0..1" SimulationResult : produces at finish
    Mission "1" *-- "0..*" SeatRequest : owns
    Mission "1" *-- "0..*" RequestHistoryEntry : records changes
    MissionData ..> Mission : registers
    SeatRequest "1" --> "1" RequestTiming : derives
    SeatRequest ..> RequestOutcome : outcome
    RequestHistoryEntry ..> HistoryAction : action
    note for SeatRequest "Retains command_id so a repeated request-creation command can be recognized; command scope and payload/collision semantics remain open"
    B3Market "1" --> "0..*" ShipAvailability : tracks copied capacity
    Ship "1" --> "0..*" ShipAvailability : reports snapshot
    Mission "1" --> "0..*" ShipOffer : has copied offer history
    Ship "1" --> "0..*" ShipOffer : supplies
    ShipOffer "1" *-- "1..*" ShipOfferRevision : versions
    note for ShipOfferRevision "Highest revision_number is current; recorded_at does not determine order"
    Mission "1" --> "0..*" SeatRFQ : requests quotations
    B3Market "1" --> "0..*" SeatRFQ : sends one per available ship in run
    ShipAvailability "1" --> "0..*" SeatRFQ : copied snapshot referenced by
    Ship "1" --> "0..*" SeatRFQ : addressed ship
    SeatRFQ "1" *-- "0..1" RFQOffer : receives at most one response
    note for RFQOffer "Response from the SeatRFQ's addressed ship; offered_seats cannot exceed the RFQ quantity. Acceptance transfers the full hold into one pending SeatRequest. Rejection or expiry releases only an unaccepted hold; ship refusal releases pending commitment."
    SeatRequest "0..1" --> "0..1" RFQOffer : follows acceptance for ship confirmation
    SeatRequest "0..*" --> "0..1" ShipOfferRevision : optionally preserves basis
    SeatRequest "1" --> "0..*" CommunicationMessage : correlates
    CommunicationMessage "1" *-- "1..*" MessageDelivery : tracks attempts
    MessageDelivery "0..*" --> "0..1" SessionEnvelope : carries
    DecisionReport "1" --> "1" SessionEnvelope : carries
    CommunicationSession "1" *-- "0..*" DecisionReport : issues
    CommunicationSession "1" *-- "0..*" NotApplied : records gaps
    CommunicationSession "1" *-- "0..1" RecoveryRequest : outstanding
    ReportCursor "0..*" --> "0..*" DecisionReport : buffers
    MessageDelivery ..> DeliveryDisposition : disposition
    MessageDelivery ..> DeliveryReason : reason
    SessionEnvelope ..> FlowDirection : direction
    SequenceControl ..> FlowDirection : direction
    RecoveryRequest ..> RecoveryRejection : refused with
    RunBaseline "1" --> "0..*" CommunicationSession : session_index
    note for CommunicationSession "Rules: accept_inbound, synchronise_inbound, issue_report, recover_reports, receive_report, classify_delivery. ReportCursor is the ship-side cursor and is not persisted."
    RequestHistoryEntry "0..*" --> "0..1" CommunicationMessage : triggered by
