---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Authoritative scoped view of Mobilisation; see the diagram index for boundary relationships.
    class MobilisationPolicy {
        -string policy_id
        -integer revision
        -string name
        -data selection_criteria
    }
    class MobilisationDecision {
        -string decision_id
        -datetime recorded_at
        -integer remaining_demand
    }
    class OfferEvaluation {
        -string evaluation_id
        -integer rank
        -integer proposed_seats
        -boolean selected
        -string reason
    }
    MobilisationDecision "0..*" --> "1" MobilisationPolicy : applies revision
    MobilisationDecision "1" *-- "0..*" OfferEvaluation : explains candidates
    note for MobilisationPolicy "External interactions: MissionOperations owns decisions; ShipMarket provides the offer revisions evaluated."
