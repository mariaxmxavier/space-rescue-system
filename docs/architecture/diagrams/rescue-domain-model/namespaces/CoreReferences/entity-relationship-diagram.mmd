---
title: Mission operations + ShipMarket (ER logical groups; Mission owns request state)
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
erDiagram
    direction TB
    %% Scoped logical ER view of CoreReferences. Cross-space relationships: Mission/request basis may refer to ShipMarket offers; requests correlate with Communication messages.
    Mission {
        string mission_id PK
        string station_name
        integer people_count
        datetime created_at
    }
    MissionData {
        string mission_id "value object, not stored"
        string station_name
        integer people_count
        datetime created_at
    }
    SeatRequest {
        string request_id PK
        string command_id
        string mission_id
        string ship_id
        integer requested_seats
        integer confirmed_seats
        RequestOutcome outcome
        datetime submitted_at
        datetime response_received_at "optional"
        datetime response_deadline "optional"
        datetime closed_at "optional"
        string quote_id "optional"
        string revision_id "optional"
        string decision_id "optional"
    }
    RequestTiming {
        datetime submitted_at "value object, not stored"
        datetime response_received_at "optional"
        decimal waiting_seconds
        decimal response_elapsed_seconds "optional"
    }
    RequestHistoryEntry {
        string event_id PK
        integer mission_sequence
        datetime recorded_at
        HistoryAction action
        integer confirmed_seats_delta
        integer pending_seats_delta
        string reason
        string message_id "optional"
    }
    MobilisationPolicy {
        string policy_id PK
        integer revision
        string name
        data selection_criteria
    }
    Mission ||..o{ SeatRequest : "owns"
    Mission ||..o{ RequestHistoryEntry : "records changes"
    MissionData ||..|| Mission : "registers"
    SeatRequest ||..|| RequestTiming : "derives"
