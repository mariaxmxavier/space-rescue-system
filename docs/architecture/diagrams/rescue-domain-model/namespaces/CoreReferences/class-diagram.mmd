---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Authoritative scoped view of CoreReferences; see the diagram index for boundary relationships.
    class Mission {
        -string mission_id
        -string station_name
        -integer people_count
        -datetime created_at
    }
    class SeatRequest {
        -string request_id
        -string command_id
        -string mission_id
        -string ship_id
        -integer requested_seats
        -integer confirmed_seats
        -RequestOutcome outcome
        -datetime submitted_at
        -datetime response_received_at
        -datetime response_deadline
        -datetime closed_at
        -string quote_id
        -string revision_id
        -string decision_id
    }
    class RequestHistoryEntry {
        -string event_id
        -integer mission_sequence
        -datetime recorded_at
        -HistoryAction action
        -integer confirmed_seats_delta
        -integer pending_seats_delta
        -string reason
        -string message_id
    }
    class RequestTiming {
        -datetime submitted_at
        -datetime response_received_at
        -decimal waiting_seconds
        -decimal response_elapsed_seconds
    }
    class MissionData {
        -string mission_id
        -string station_name
        -integer people_count
        -datetime created_at
    }
    class RequestOutcome {
        <<enumeration>>
        pending
        accepted
        partially_accepted
        refused
        cancelled
        expired
    }
    class HistoryAction {
        <<enumeration>>
        request_created
        accepted
        partially_accepted
        refused
        cancelled
        expired
    }
    class MobilisationPolicy {
        -string policy_id
        -integer revision
        -string name
        -data selection_criteria
    }
    Mission "1" *-- "0..*" SeatRequest : owns
    Mission "1" *-- "0..*" RequestHistoryEntry : records changes
    MissionData ..> Mission : registers
    SeatRequest "1" --> "1" RequestTiming : derives
    note for Mission "External interactions: Mission/request basis may refer to ShipMarket offers; requests correlate with Communication messages."
