---
title: Communication
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
erDiagram
    direction TB
    %% Scoped logical ER view of Communication. Cross-space relationships: Messages correlate with MissionOperations requests and may trigger request-history entries.
    CommunicationMessage {
        string message_id PK
        string correlation_id
        string request_id
        string kind
        data payload
        datetime sent_at
    }
    MessageDelivery {
        string delivery_id PK
        integer attempt_number
        datetime received_at "optional"
        string disposition
        string reason
        number communication_rtt_seconds "optional"
        data envelope "optional"
    }
    COMMUNICATION_SESSION {
        string session_id PK
        integer version
        integer next_inbound
        integer next_outbound
    }
    DECISION_REPORT {
        string report_id PK
        data envelope
        string message_id
        string delivery_id
        string mission_id "optional"
        string disposition
        string reason
        integer mission_sequence "optional"
        integer after_mission_sequence
    }
    NOT_APPLIED {
        string session_id
        integer version
        integer from_sequence
        integer count
    }
    REQUEST_HISTORY_ENTRY {
        integer mission_sequence
    }
    CommunicationMessage ||..|{ MessageDelivery : "tracks attempts"
    COMMUNICATION_SESSION ||..o{ MessageDelivery : "sequences deliveries"
    COMMUNICATION_SESSION ||..o{ DECISION_REPORT : "retains reports"
    COMMUNICATION_SESSION ||..o{ NOT_APPLIED : "records gaps"
    MessageDelivery ||..o| DECISION_REPORT : "is reported by"
    DECISION_REPORT }o..o| REQUEST_HISTORY_ENTRY : "cross-references mission_sequence"
