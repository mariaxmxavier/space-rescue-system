---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Authoritative scoped view of MissionOperations; see the diagram index for boundary relationships.
    class RescueCentral {
        -string central_id
        -string application_run_id
        -Mission[] registry
        +registerMission(mission_data)
        +mobilise(mission_id)
        +recordResponse(request, response)
        +cancelRequest(request)
        +expireRequest(request)
        +getProgress(mission_id)
    }
    class Mission {
        -string mission_id
        -string station_name
        -integer people_count
        -datetime created_at
    }
    class SeatRequest {
        -string request_id
        -string command_id
        -integer requested_seats
        -integer confirmed_seats
        -string outcome
        -datetime submitted_at
        -datetime response_received_at
        -datetime response_deadline
        -datetime closed_at
    }
    class RequestHistoryEntry {
        -string event_id
        -integer mission_sequence
        -datetime recorded_at
        -string action
        -integer confirmed_seats_delta
        -integer pending_seats_delta
        -string reason
    }
    class MissionProgress {
        -integer demand
        -integer confirmed
        -integer pending
        -integer unconfirmed
        -integer additional_needed
        -string status
    }
    RescueCentral "1" --> "0..*" Mission : registry keyed by mission_id
    Mission "1" *-- "0..*" SeatRequest : owns
    SeatRequest "1" *-- "1..*" RequestHistoryEntry : records changes
    Mission "1" --> "1" MissionProgress : derives
    note for RescueCentral "External interactions: Mission delegates requests to ShipMarket RFQs/offers; Mission records Mobilisation decisions."
