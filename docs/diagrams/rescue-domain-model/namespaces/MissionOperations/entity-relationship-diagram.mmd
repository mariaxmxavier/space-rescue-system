---
title: Mission operations + ShipMarket (ER logical groups; Mission owns request state)
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
erDiagram
    direction TB
    %% Scoped logical ER view of MissionOperations. Cross-space relationships: Mission delegates requests to ShipMarket RFQs/offers; Mission records Mobilisation decisions.
    RescueCentral {
        string central_id PK
        string application_run_id PK
    }
    Mission {
        string mission_id PK
        string station_name
        integer people_count
        datetime created_at
    }
    SeatRequest {
        string request_id PK
        string command_id
        integer requested_seats
        integer confirmed_seats
        string outcome
        datetime submitted_at
        datetime response_received_at "optional"
        datetime response_deadline "optional"
        datetime closed_at "optional"
    }
    RequestHistoryEntry {
        string event_id PK
        integer mission_sequence
        datetime recorded_at
        string action
        integer confirmed_seats_delta
        integer pending_seats_delta
        string reason
    }
    MissionProgress {
        integer demand
        integer confirmed
        integer pending
        integer unconfirmed
        integer additional_needed
        string status
    }
    RescueCentral ||..o{ Mission : "registry lookup by mission_id"
    Mission ||..o{ SeatRequest : "owns"
    SeatRequest ||..|{ RequestHistoryEntry : "records changes"
    Mission ||..|| MissionProgress : "derives"
