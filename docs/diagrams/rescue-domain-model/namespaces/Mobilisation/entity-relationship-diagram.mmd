---
erDiagram
    direction TB
    %% Scoped logical ER view of Mobilisation. Cross-space relationships: MissionOperations owns decisions; ShipMarket provides the offer revisions evaluated.
    MobilisationPolicy {
        string policy_id PK
        integer revision
        string name
        data selection_criteria
    }
    MobilisationDecision {
        string decision_id PK
        datetime recorded_at
        integer remaining_demand
    }
    OfferEvaluation {
        string evaluation_id PK
        integer rank
        integer proposed_seats
        boolean selected
        string reason
    }
    MobilisationDecision }o..|| MobilisationPolicy : "applies revision"
    MobilisationDecision ||..o{ OfferEvaluation : "explains candidates"
