---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Full conceptual attributes; namespace boxes are visual groups only.
    namespace Experiments {
        class RescueScenario {
            string scenario_id
            integer revision
            string name
            data baseline
            data response_rules
            data availability_changes
            number time_horizon_seconds
            integer seed
        }
        class CommunicationProfile {
            string profile_id
            number outbound_delay_seconds
            number decision_delay_seconds
            number return_delay_seconds
            data loss_rule
            data duplication_rule
            data reordering_rule
        }
        class SimulationRun {
            string run_id
            datetime started_at
            datetime finished_at
            string status
        }
        class SimulationResult {
            boolean completed
            integer confirmed_seats
            integer unmet_demand
            integer requests_sent
            integer released_seats
            number confirmation_elapsed_seconds
            number latest_arrival_estimate_seconds
        }
    }
    namespace Communication {
        class CommunicationMessage {
            string message_id
            string correlation_id
            string kind
            data payload
            datetime sent_at
        }
        class MessageDelivery {
            string delivery_id
            integer attempt_number
            datetime received_at
            string disposition
            string reason
        }
    }
    namespace CoreReferences {
        class RescueMission {
            string mission_id
            string station_name
            integer people_count
            datetime created_at
        }
        class Ship {
            string ship_id
            string name
        }
        class SeatRequest {
            string request_id
            string command_id
            integer requested_seats
            integer confirmed_seats
            string outcome
            datetime submitted_at
            datetime response_received_at
            datetime response_deadline
            datetime closed_at
        }
        class RequestHistoryEntry {
            string event_id
            integer mission_sequence
            datetime recorded_at
            string action
            integer confirmed_seats_delta
            integer pending_seats_delta
            string reason
        }
        class MobilisationPolicy {
            string policy_id
            integer revision
            string name
            data selection_criteria
        }
    }
    RescueScenario "1" *-- "0..*" CommunicationProfile : configures
    CommunicationProfile "0..*" --> "1" Ship : targets baseline ship
    SimulationRun "0..*" --> "1" RescueScenario : uses revision
    SimulationRun "0..*" --> "1" MobilisationPolicy : compares revision
    SimulationRun "1" *-- "1" RescueMission : owns isolated copy
    SimulationRun "1" *-- "0..1" SimulationResult : produces at finish
    RescueMission "1" *-- "0..*" SeatRequest : owns
    SeatRequest "1" --> "0..*" CommunicationMessage : correlates
    CommunicationMessage "1" *-- "1..*" MessageDelivery : tracks attempts
    RequestHistoryEntry "0..*" --> "0..1" CommunicationMessage : triggered by
