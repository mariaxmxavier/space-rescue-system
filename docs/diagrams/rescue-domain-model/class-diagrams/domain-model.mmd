---
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
    hideEmptyMembersBox: true
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
classDiagram
    direction LR
    %% Full conceptual attributes; namespace boxes are visual groups only.
    namespace MissionOperations {
        class RescueCentral {
            -string central_id
            -string application_run_id
            -Mission[] registry
            +registerMission(mission_data)
            +mobilise(mission_id)
            +recordResponse(request, response)
            +cancelRequest(request)
            +expireRequest(request)
            +getProgress(mission_id)
        }
        class Mission {
            -string mission_id
            -string station_name
            -integer people_count
            -datetime created_at
        }
        class SeatRequest {
            -string request_id
            -string command_id
            -integer requested_seats
            -integer confirmed_seats
            -string outcome
            -datetime submitted_at
            -datetime response_received_at
            -datetime response_deadline
            -datetime closed_at
        }
        class RequestHistoryEntry {
            -string event_id
            -integer mission_sequence
            -datetime recorded_at
            -string action
            -integer confirmed_seats_delta
            -integer pending_seats_delta
            -string reason
        }
        class MissionProgress {
            -integer demand
            -integer confirmed
            -integer pending
            -integer unconfirmed
            -integer additional_needed
            -string status
        }
    }
    namespace ShipMarket {
        class B3Market {
            -string market_id
        }
        class Ship {
            -string ship_id
            -string name
        }
        class ShipAvailability {
            -string availability_id
            -integer total_seats
            -number arrival_estimate_seconds
            -boolean available
            -datetime recorded_at
        }
        class ShipOffer {
            -string offer_id
            -string mission_id
            -string ship_id
        }
        class ShipOfferRevision {
            -string revision_id
            -integer revision_number
            -integer capacity
            -number arrival_estimate_seconds
            -boolean available
            -datetime recorded_at
        }
        class SeatRFQ {
            -string rfq_id
            -string mission_id
            -string ship_id
            -string availability_id
            -integer requested_seats
            -string status
            -datetime sent_at
            -datetime response_deadline
        }
        class RFQOffer {
            -string offer_id
            -integer offered_seats
            -number arrival_estimate_seconds
            -datetime expires_at
            -datetime recorded_at
            -string status
        }
    }
    namespace Mobilisation {
        class MobilisationPolicy {
            -string policy_id
            -integer revision
            -string name
            -data selection_criteria
        }
        class MobilisationDecision {
            -string decision_id
            -datetime recorded_at
            -integer remaining_demand
        }
        class OfferEvaluation {
            -string evaluation_id
            -integer rank
            -integer proposed_seats
            -boolean selected
            -string reason
        }
    }
    RescueCentral "1" --> "0..*" Mission : registry keyed by mission_id
    note for RescueCentral "Exactly one instance per application run; registry lookup uses Mission mission_id"
    RescueCentral "1" --> "1" B3Market : coordinates requests through
    B3Market "1" --> "0..*" ShipAvailability : tracks changing capacity
    Ship "1" --> "0..*" ShipAvailability : reports availability
    Mission "1" --> "0..*" SeatRFQ : requests quotations
    B3Market "1" --> "0..*" SeatRFQ : sends one per available ship
    ShipAvailability "1" --> "0..*" SeatRFQ : snapshot referenced by
    Ship "1" --> "0..*" SeatRFQ : addressed ship
    SeatRFQ "1" *-- "0..1" RFQOffer : receives at most one response
    note for RFQOffer "Response from the SeatRFQ's addressed ship; offered_seats cannot exceed the RFQ quantity. The response holds seats until acceptance, rejection, or expiry."
    note for B3Market "Per ship, counts active unaccepted RFQOffer holds, pending SeatRequest commitments, and confirmed commitments once each against the latest ShipAvailability.total_seats. Acceptance transfers a hold to pending atomically; capacity reductions flag shortfall and block new allocation. Does not optimise the fleet."
    note for RFQOffer "Pending offer holds seats. Central acceptance transfers the hold into a pending SeatRequest for ship confirmation. Quote rejection or expiry releases only an unaccepted hold; ship refusal releases the pending commitment."
    Mission "1" *-- "0..*" SeatRequest : owns
    note for SeatRequest "Retains command_id so a repeated request-creation command can be recognized; command scope and payload/collision semantics remain open"
    note for Mission "Owns request transitions and mission invariants; people_count is fixed after registration"
    Mission "1" --> "0..*" ShipOffer : receives
    Ship "1" --> "0..*" ShipOffer : supplies
    ShipOffer "1" *-- "1..*" ShipOfferRevision : versions
    note for ShipOfferRevision "Highest revision_number is current; recorded_at does not determine order"
    SeatRequest "0..*" --> "0..1" ShipOfferRevision : optionally preserves basis
    SeatRequest "0..1" --> "0..1" RFQOffer : follows acceptance for ship confirmation
    SeatRequest "1" *-- "1..*" RequestHistoryEntry : records changes
    Mission "1" --> "1" MissionProgress : derives
    Mission "1" --> "0..*" MobilisationDecision : records
    MobilisationDecision "0..*" --> "1" MobilisationPolicy : applies revision
    MobilisationDecision "1" *-- "0..*" OfferEvaluation : explains candidates
    OfferEvaluation "0..*" --> "1" ShipOfferRevision : assesses
    SeatRequest "0..*" --> "0..1" MobilisationDecision : originates from
