---
title: Mission operations + ShipMarket (ER logical groups; Mission owns request state)
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
