---
erDiagram
    direction TB
    %% Logical ER view; dashed lines do not imply UML dependency or lifecycle ownership.
    %% Exactly one RescueCentral exists per application run; identity remains (application_run_id, central_id).
    %% Its conceptual registry looks up multiple Mission instances by mission_id; this is not a storage FK.
    %% Registered missions retain their existing request history for the run.
    %% Mission owns request state transitions and mission invariants; these are behaviours, not additional stored fields.
    %% Mission people_count is fixed at registration; later attempts to change it are rejected.
    %% Per ship, B3Market counts active unaccepted RFQOffer holds, pending SeatRequest commitments, and confirmed commitments once each against latest ShipAvailability.total_seats.
    %% Acceptance atomically transfers a quote hold into a pending request; quote rejection/expiry releases only unaccepted holds; ship refusal releases pending commitment.
    %% Logical group MissionOperations: RescueCentral, Mission, SeatRequest, history and progress.
    RescueCentral {
        string central_id PK
        string application_run_id PK
    }
    B3Market {
        string market_id PK
    }
    Mission {
        string mission_id PK
        string station_name
        integer people_count
        datetime created_at
    }
    SeatRequest {
        string request_id PK
        string command_id
        integer requested_seats
        integer confirmed_seats
        string outcome
        datetime submitted_at
        datetime response_received_at "optional"
        datetime response_deadline "optional"
        datetime closed_at "optional"
    }
    SeatRFQ {
        string rfq_id PK
        string mission_id
        string ship_id
        string availability_id
        integer requested_seats
        string status
        datetime sent_at
        datetime response_deadline "optional"
    }
    RFQOffer {
        string offer_id PK
        string rfq_id
        integer offered_seats
        number arrival_estimate_seconds
        datetime expires_at
        datetime recorded_at
        string status
    }
    RequestHistoryEntry {
        string event_id PK
        integer mission_sequence
        datetime recorded_at
        string action
        integer confirmed_seats_delta
        integer pending_seats_delta
        string reason
    }
    MissionProgress {
        integer demand
        integer confirmed
        integer pending
        integer unconfirmed
        integer additional_needed
        string status
    }
    %% Logical group ShipMarket: B3Market, Ship, ShipAvailability, RFQ concepts and ship offers.
    Ship {
        string ship_id PK
        string name
    }
    ShipAvailability {
        string availability_id PK
        string ship_id
        integer total_seats
        number arrival_estimate_seconds
        boolean available
        datetime recorded_at
    }
    ShipOffer {
        string offer_id PK
        string mission_id
        string ship_id
    }
    ShipOfferRevision {
        string revision_id PK
        integer revision_number
        integer capacity
        number arrival_estimate_seconds
        boolean available
        datetime recorded_at
    }
    %% Highest revision_number is current; recorded_at does not determine revision order.
    %% Logical group MissionOperations: mobilisation decisions and evaluations.
    MobilisationPolicy {
        string policy_id PK
        integer revision
        string name
        data selection_criteria
    }
    MobilisationDecision {
        string decision_id PK
        datetime recorded_at
        integer remaining_demand
    }
    OfferEvaluation {
        string evaluation_id PK
        integer rank
        integer proposed_seats
        boolean selected
        string reason
    }
    RescueCentral ||..o{ Mission : "registry lookup by mission_id"
    RescueCentral ||..|| B3Market : "coordinates RFQs through"
    B3Market ||..o{ ShipAvailability : "tracks changing capacity"
    Ship ||..o{ ShipAvailability : "reports availability"
    Mission ||..o{ SeatRFQ : "requests quotations"
    B3Market ||..o{ SeatRFQ : "sends one per available ship"
    ShipAvailability ||..o{ SeatRFQ : "snapshot referenced by"
    Ship ||..o{ SeatRFQ : "addressed ship"
    SeatRFQ ||..o| RFQOffer : "receives at most one response"
    Mission ||..o{ SeatRequest : "owns"
    RFQOffer o|..o| SeatRequest : "optional accepted quote starts pending ship confirmation"
    Mission ||..o{ ShipOffer : "receives"
    Ship ||..o{ ShipOffer : "supplies"
    ShipOffer ||..|{ ShipOfferRevision : "versions; highest revision_number is current; recorded_at does not order"
    SeatRequest }o..o| ShipOfferRevision : "optionally preserves basis"
    SeatRequest ||..|{ RequestHistoryEntry : "records changes"
    Mission ||..|| MissionProgress : "derives"
    Mission ||..o{ MobilisationDecision : "records"
    MobilisationDecision }o..|| MobilisationPolicy : "applies revision"
    MobilisationDecision ||..o{ OfferEvaluation : "explains candidates"
    OfferEvaluation }o..|| ShipOfferRevision : "assesses"
    SeatRequest }o..o| MobilisationDecision : "originates from"
