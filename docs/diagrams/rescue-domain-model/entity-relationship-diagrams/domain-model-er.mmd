---
title: Mission operations — RescueMission owns request state
config:
  layout: elk
  theme: base
  htmlLabels: false
  fontFamily: Arial
  themeVariables:
    primaryColor: '#e5e9f0'
    primaryTextColor: '#2e3440'
    primaryBorderColor: '#5e81ac'
    lineColor: '#4c566a'
    tertiaryColor: '#eceff4'
    fontFamily: 'Arial, sans-serif'
  elk:
    mergeEdges: false
    nodePlacementStrategy: LINEAR_SEGMENTS
  class:
    nodeSpacing: 90
    rankSpacing: 100
    padding: 24
    diagramPadding: 40
  er:
    nodeSpacing: 90
    rankSpacing: 100
    diagramPadding: 30
---
erDiagram
    direction TB
    %% Logical ER view; dashed lines do not imply UML dependency or lifecycle ownership.
    %% RescueCentral identity, registry, missions, and their history live for one application run.
    %% Its registry relates registered missions; each mission retains its existing request history.
    %% RescueMission owns request state transitions and mission invariants; these are behaviours, not additional stored fields.
    %% MissionOperations
    RescueCentral {
        string central_id PK
        string application_run_id PK
    }
    RescueMission {
        string mission_id PK
        string station_name
        integer people_count
        datetime created_at
    }
    SeatRequest {
        string request_id PK
        string command_id
        integer requested_seats
        integer confirmed_seats
        string outcome
        datetime submitted_at
        datetime response_received_at "optional"
        datetime response_deadline "optional"
        datetime closed_at "optional"
    }
    RequestHistoryEntry {
        string event_id PK
        integer mission_sequence
        datetime recorded_at
        string action
        integer confirmed_seats_delta
        integer pending_seats_delta
        string reason
    }
    MissionProgress {
        integer demand
        integer confirmed
        integer pending
        integer unconfirmed
        integer additional_needed
        string status
    }
    %% ShipsAndOffers
    Ship {
        string ship_id PK
        string name
    }
    ShipOffer {
        string offer_id PK
        string mission_id
        string ship_id
    }
    ShipOfferRevision {
        string revision_id PK
        integer revision_number
        integer capacity
        number arrival_estimate_seconds
        boolean available
        datetime recorded_at
    }
    %% Mobilisation
    MobilisationPolicy {
        string policy_id PK
        integer revision
        string name
        data selection_criteria
    }
    MobilisationDecision {
        string decision_id PK
        datetime recorded_at
        integer remaining_demand
    }
    OfferEvaluation {
        string evaluation_id PK
        integer rank
        integer proposed_seats
        boolean selected
        string reason
    }
    RescueCentral ||..o{ RescueMission : "registers and coordinates"
    RescueMission ||..o{ SeatRequest : "owns"
    RescueMission ||..o{ ShipOffer : "receives"
    Ship ||..o{ ShipOffer : "supplies"
    ShipOffer ||..|{ ShipOfferRevision : "versions"
    SeatRequest }o..|| ShipOfferRevision : "preserves basis"
    SeatRequest ||..|{ RequestHistoryEntry : "records changes"
    RescueMission ||..|| MissionProgress : "derives"
    RescueMission ||..o{ MobilisationDecision : "records"
    MobilisationDecision }o..|| MobilisationPolicy : "applies revision"
    MobilisationDecision ||..o{ OfferEvaluation : "explains candidates"
    OfferEvaluation }o..|| ShipOfferRevision : "assesses"
    SeatRequest }o..o| MobilisationDecision : "originates from"
